generator client {
  provider = "prisma-client"
  output   = "../src/shared/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  IN_PROGRESS
  ON_HOLD
  CLOSED
}

enum EventKind {
  OPENED
  DEADLINE
  HEARING
}

model Client {
  id        String      @id @default(cuid())
  name      String
  email     String?
  cases     LegalCase[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Lawyer {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  cases     LegalCase[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LegalCase {
  id          String      @id @default(cuid())
  number      String      @unique
  title       String
  description String
  category    String
  status      CaseStatus  @default(IN_PROGRESS)
  openedAt    DateTime    @db.Date
  clientId    String
  lawyerId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lawyer      Lawyer      @relation(fields: [lawyerId], references: [id], onDelete: Restrict)
  events      CaseEvent[]
  documents   Document[]
  emails      Email[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clientId])
  @@index([lawyerId, status])
}

model CaseEvent {
  id          String    @id @default(cuid())
  caseId      String
  legalCase   LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind        EventKind
  date        DateTime  @db.Date
  title       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([caseId, date])
}

// Metadata only. Google integrations will be implemented in a later step.
model Document {
  id          String    @id @default(cuid())
  caseId      String
  legalCase   LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String?
  driveFileId String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([caseId])
}

model Email {
  id             String    @id @default(cuid())
  caseId         String
  legalCase      LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  gmailMessageId String?   @unique
  gmailThreadId  String?
  subject        String
  sender         String
  receivedAt     DateTime
  createdAt      DateTime  @default(now())

  @@index([caseId, receivedAt])
  @@index([gmailThreadId])
}
